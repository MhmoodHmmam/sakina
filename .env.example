# Nokia Network-as-Code is served via RapidAPI:
#   NetworkAsCodeApiEnvironment.DEFAULT = https://network-as-code.p-eu.rapidapi.com
# so this must be your RapidAPI key with an active NaC subscription.
NAC_API_KEY=your_rapidapi_key_here

# Google AI Studio — free, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# Groq — free fallback: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# live | replay | hybrid
SAKINA_MODE=hybrid
